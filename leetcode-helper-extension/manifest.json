{
  "manifest_version": 3,
  "name": "Leetcode Helper Extension",
  "version": "1.0",
  "description": "A helper extension for LeetCode",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  }
}
